{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zady.app/schema/unit.schema.json",
  "title": "زادِي — وحدة دراسية كاملة (ملف واحد)",
  "description": "ملف واحد لكل وحدة يجمع المادة العلمية كلها: البيانات الوصفية، الفيديو، نصّ الدرس، الخريطة، البطاقات، الفراغات، اختبار QCM، بنك الأسئلة، والمراجعة السريعة. كل الملفات في src/data/units/ يجب أن تطابق هذا المخطط.",
  "type": "object",
  "required": ["schemaVersion", "unit", "lesson", "mindmap", "flashcards", "cloze", "quiz", "questionBank", "revision"],
  "additionalProperties": false,

  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": {
      "const": 2,
      "description": "إصدار المخطط. أي تغيير كاسر يرفع الرقم ويُرافق بسكربت هجرة."
    },

    "source": {
      "type": "object",
      "description": "من أين جاءت المادة: التدرّج الرسمي، ومن راجعها.",
      "additionalProperties": false,
      "properties": {
        "curriculum": { "type": "string" },
        "subject": { "type": "string" },
        "reviewedBy": { "type": ["string", "null"] },
        "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      }
    },

    "unit": {
      "type": "object",
      "required": ["id", "slug", "title", "shortTitle", "badge"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 99 },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "معرّف لاتيني للروابط والمفاتيح — لا يتغيّر بعد النشر (تقدّم الطالب مرتبط به)."
        },
        "title": { "type": "string", "minLength": 6, "description": "العنوان الكامل كما في التدرّج." },
        "shortTitle": { "type": "string", "minLength": 3 },
        "badge": { "type": "string", "pattern": "^الوحدة \\d{2}$" },
        "field": { "type": "string", "default": "العلوم الإسلامية" },
        "timeAllocation": { "type": "string", "description": "مثل: «ساعتان»." },
        "targetAudience": { "type": "string", "description": "الشعب المعنية." },
        "learningObjective": { "type": "string", "minLength": 20, "description": "الكفاءة المستهدفة بجملة واحدة." },
        "mindmapImage": {
          "type": "string",
          "pattern": "^/lessons/.+\\.webp$",
          "description": "الخريطة المصوّرة (webp فقط، < 250KB)."
        },
        "video": { "$ref": "#/$defs/video" }
      }
    },

    "lesson": {
      "type": "object",
      "required": ["sections"],
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "minItems": 1,
          "description": "محاور نصّ الدرس بالترتيب. المفتاح الداخلي للسياق لا يُعرض، والعنوان هو ما يراه الطالب.",
          "items": {
            "type": "object",
            "required": ["key", "title", "content"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "pattern": "^[a-z0-9_]+$" },
              "title": { "type": "string", "minLength": 3 },
              "content": { "$ref": "#/$defs/sectionContent" }
            }
          }
        }
      }
    },

    "mindmap": {
      "type": "object",
      "required": ["root"],
      "additionalProperties": false,
      "properties": {
        "root": { "$ref": "#/$defs/mindmapNode" }
      }
    },

    "flashcards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "answer"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": ["string", "number"], "description": "ثابت: تقدّم الحفظ مرتبط به." },
          "question": { "type": "string", "minLength": 3 },
          "answer": { "type": "string", "minLength": 3 },
          "section": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },

    "cloze": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "concept_id", "concept_title", "text_with_masks", "answers"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "concept_id": { "type": "string" },
          "concept_title": { "type": "string" },
          "text_with_masks": {
            "type": "string",
            "pattern": "\\{mask\\d+\\}",
            "description": "النصّ وفيه أقنعة {mask1} {mask2}… وكل قناع له مفتاح في answers."
          },
          "answers": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "{\"mask1\": \"…\"} — المفاتيح يجب أن تطابق الأقنعة حرفًا بحرف."
          },
          "category": { "type": "string" },
          "prohibited_synonyms": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "quiz": {
      "type": "array",
      "minItems": 1,
      "description": "اختبار QCM: خيار واحد صحيح بين أربعة، وتفسير يظهر بعد الإجابة.",
      "items": {
        "type": "object",
        "required": ["question_id", "question", "options", "correct_answer", "explanation"],
        "additionalProperties": false,
        "properties": {
          "question_id": { "type": "string" },
          "question": { "type": "string", "minLength": 6 },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1 }
          },
          "correct_answer": {
            "type": "string",
            "description": "نصّ الخيار الصحيح كما هو في options (تُخلط الخيارات عند العرض)."
          },
          "hint": { "type": "string" },
          "explanation": { "type": "string", "minLength": 10 }
        }
      }
    },

    "questionBank": {
      "type": "array",
      "description": "أسئلة البكالوريا مع عناصر الإجابة. التصنيف داخلي ولا يُعرض للطالب.",
      "items": {
        "type": "object",
        "required": ["id", "category", "question", "modelAnswer"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "type": { "type": "string" },
          "question": { "type": "string", "minLength": 3 },
          "modelAnswer": { "type": "string", "minLength": 3 },
          "scoringRubric": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["criterion", "points"],
              "additionalProperties": false,
              "properties": {
                "criterion": { "type": "string" },
                "points": { "type": "number", "minimum": 0 }
              }
            }
          },
          "officialMarks": { "type": "number", "minimum": 0 },
          "examinerNotes": { "type": "string" },
          "text": { "type": "string", "description": "الشاهد الشرعي المرفق بالسؤال إن وُجد." },
          "reference": { "type": "string" },
          "anchor": { "type": "string", "description": "محل الشاهد من النصّ." },
          "session": { "type": "string", "description": "مصدر السؤال: «بكالوريا 2024 — الموضوع الأول»." }
        }
      }
    },

    "revision": {
      "type": "object",
      "required": ["lastMinute", "summary", "rules"],
      "additionalProperties": false,
      "properties": {
        "lastMinute": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "items"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "summary": {
          "type": "array",
          "description": "ملخّص الحفظ. هنا وحدها تُذكر القواعد والضوابط المنهجية.",
          "items": {
            "type": "object",
            "required": ["title", "items"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "rules": { "type": "array", "items": { "type": "string", "minLength": 10 } },
        "differentiation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "termA", "termB", "distinction"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "termA": { "type": "string" },
              "termB": { "type": "string" },
              "distinction": { "type": "string" },
              "pitfall": { "type": "string" },
              "examinerWarning": { "type": "string" }
            }
          }
        },
        "previousBac": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["session", "question", "answer"],
            "additionalProperties": false,
            "properties": {
              "session": { "type": "string" },
              "question": { "type": "string" },
              "answer": { "type": "string" }
            }
          }
        }
      }
    },

    "proofs": {
      "type": "array",
      "description": "محرّك الشواهد الشرعية: نصّ الآية/الحديث ومحلّه ومؤشراته. مادة علمية محفوظة، تُستعمل عند بناء قسم الشواهد.",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "surah": { "type": "string" },
          "ayah": { "type": ["number", "string"] },
          "text": { "type": "string" },
          "anchor": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string", "description": "إضاءة تعليمية — لا تُحفظ." }
        }
      }
    }
  },

  "$defs": {
    "video": {
      "type": "object",
      "description": "شرح مرئي للوحدة. يظهر كخطوة أولى في مرحلة «استيعاب»؛ إن غاب الحقل لا تظهر الخطوة إطلاقًا.",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["youtube", "vimeo", "file"] },
        "id": { "type": "string", "description": "معرّف الفيديو عند youtube/vimeo." },
        "src": { "type": "string", "description": "مسار الملف عند provider=file، مثل /lessons/unit01.mp4." },
        "title": { "type": "string" },
        "duration": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}$" },
        "poster": { "type": "string", "description": "صورة الغلاف قبل التشغيل (webp/jpg) — تقلّل التحميل الثقيل." },
        "captions": { "type": "string", "description": "ملف ترجمة/تفريغ .vtt بالعربية (مطلوب عند provider=file)." },
        "chapters": {
          "type": "array",
          "description": "فصول الفيديو. تُعرض كقائمة، وتصبح أزرار انتقال عند provider=file.",
          "items": {
            "type": "object",
            "required": ["at", "title"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "string", "pattern": "^\\d{1,2}:\\d{2}$" },
              "title": { "type": "string", "minLength": 3 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "youtube" } } },
          "then": { "required": ["id", "title"] }
        },
        {
          "if": { "properties": { "provider": { "const": "vimeo" } } },
          "then": { "required": ["id", "title"] }
        },
        {
          "if": { "properties": { "provider": { "const": "file" } } },
          "then": { "required": ["src", "title"] }
        }
      ]
    },

    "mindmapNode": {
      "type": "object",
      "description": "عنصر مفهومي فقط: تسمية وشرح. لا شواهد ولا كلمات مفتاحية ولا توجيهات.",
      "required": ["id", "label"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string", "minLength": 2 },
        "details": { "type": "string", "description": "شرح العنصر — إلزامي في الأوراق." },
        "node_type": { "type": "string" },
        "color": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/mindmapNode" }
        }
      }
    },

    "sectionContent": {
      "type": ["string", "object", "array"],
      "description": "محتوى المحور. الأشكال المفهومة: نصّ، أو كائن بمفاتيح معروفة (title، linguistic_definition، idiomatic_definition، definition، explanation، quranic_proof، prophetic_proof، proof_anchor_phrase، tawheed_categories، effects…)، أو قائمة بنود. وأي مفتاح ينتهي بـ note/tip/guidance يُعرض بطاقةَ «إضاءة/فائدة» لا عنصرًا مفهوميًا."
    }
  }
}
